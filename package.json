{
  "name": "fix11y-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run check:core-sync && node --test scripts/*.test.js && npm test --workspaces --if-present",
    "test:core": "npm test --workspace=@fix11y/core",
    "sync:core": "node scripts/sync-core.js",
    "check:core-sync": "node scripts/sync-core.js --check"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "author": "",
  "license": "MIT"
}
