# ==============================================================================
# fix11y Environment Variables
# Copy this file to .env and configure the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Engine (Google Gemini 2.5 Flash)
# ------------------------------------------------------------------------------
# Primary API key for autonomous CST remediation in apps/agent.
# Get an API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Fallback (Anthropic Claude):
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 2. E2B MicroVM Sandboxing
# ------------------------------------------------------------------------------
# Required for running build & verification in ephemeral Firecracker microVMs.
# Get an API key from: https://e2b.dev/
E2B_API_KEY=your_e2b_api_key_here

# ------------------------------------------------------------------------------
# 3. GitHub Webhook & Redis Queue (BullMQ)
# ------------------------------------------------------------------------------
# Secret configured in your GitHub App / repository webhook settings.
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# Redis connection URL for BullMQ job queueing (default: local Redis instance).
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# 4. GitHub App Authentication (Automated PR Creation)
# ------------------------------------------------------------------------------
# App ID from GitHub App Settings (General > About > App ID).
GITHUB_APP_ID=

# GitHub App RSA Private Key in PEM format.
# Can be formatted as a single multiline string or single-line with \n.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Installation ID for the specific GitHub organization or user account.
GITHUB_APP_INSTALLATION_ID=

# (Optional fallback): Personal Access Token (PAT) with repo scope if not using GitHub App.
GITHUB_TOKEN=

# ------------------------------------------------------------------------------
# 5. CLI & Accessibility Options (Optional)
# ------------------------------------------------------------------------------
# Set to 'true' to enforce screen-reader safe flat milestone logs (no spinners/ANSI movement).
ACCESSIBLE=false

# Set to any non-empty value to suppress ANSI color codes in terminal outputs.
NO_COLOR=
